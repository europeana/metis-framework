    <skos:prefLabel xml:lang="de">Dorf</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">vilas</skos:prefLabel>
    <skos:prefLabel xml:lang="es">aldeas</skos:prefLabel>
  </skos:Concept>
